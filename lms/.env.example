# --- Flask ---
# REQUIRED: Flask session signing + TOTP MFA secret encryption (Fernet key is
# derived from this via PBKDF2). The app FAILS TO START if this is unset/empty
# — it will never silently store TOTP secrets in plaintext.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Database: leave empty for local SQLite. For Postgres set e.g.
# DATABASE_URL=postgresql://user:password@host:5432/lmsdb
DATABASE_URL=
# Optional: custom sqlite path / upload dir (defaults shown)
# SQLITE_PATH=/app/data/lms.db
# UPLOAD_DIR=/app/data/uploads

# --- Razorpay (leave empty = stub/test mode, payments complete without real money) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:5000
