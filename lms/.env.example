# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
# Database: leave empty for local SQLite. For Postgres set e.g.
# DATABASE_URL=postgresql://user:password@host:5432/lmsdb
DATABASE_URL=
# Optional: custom sqlite path / upload dir (defaults shown)
# SQLITE_PATH=/app/data/lms.db
# UPLOAD_DIR=/app/data/uploads

# --- Razorpay (leave empty = stub/test mode, payments complete without real money) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:5000
